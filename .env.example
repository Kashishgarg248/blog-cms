PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blog_cms
DB_USER=postgres
DB_PASSWORD=yourpassword
# Set to true when using a hosted Postgres provider that requires SSL (e.g. Supabase, Neon, Railway).
# Leave unset/false for local Postgres.
DB_SSL=false
SESSION_SECRET=your_super_secret_key_change_this
SUPER_ADMIN_EMAIL=superadmin@blog.com
SUPER_ADMIN_PASSWORD=SuperAdmin@123

# Optional — seeds a second account (e.g. your CEO) with checker rights
# (approve_change / reject_change) plus blog CRUD. Needed because self-approval
# is blocked: without a second checker, the Super Admin's own changes could
# never be approved. Leave blank to skip and assign a checker manually later.
CEO_NAME=CEO
CEO_EMAIL=ceo@blog.com
CEO_PASSWORD=Ceo@1234