<div class="page-header">
  <div>
    <a href="/blogs" class="btn btn-outline btn-sm"><i class="fas fa-arrow-left"></i> Back</a>
  </div>
  <div class="blog-actions-header">
    <% if (can('update_blog') && (isOwner || can('view_all_blogs'))) { %>
    <a href="/blogs/<%= blog.id %>/edit" class="btn btn-outline">
      <i class="fas fa-edit"></i> Edit
    </a>
    <% } %>
    <% if (can('delete_blog') && (isOwner || can('view_all_blogs'))) { %>
    <form action="/blogs/<%= blog.id %>?_method=DELETE" method="POST" style="display:inline"
      onsubmit="return confirm('Are you sure you want to delete this blog?')">
      <button class="btn btn-danger"><i class="fas fa-trash"></i> Delete</button>
    </form>
    <% } %>
  </div>
</div>

<% if (pendingChange) { %>
<div class="alert alert-warning">
  <i class="fas fa-hourglass-half"></i>
  <div>
    <strong><%= pendingChange.action === 'delete' ? 'A delete request' : 'An edit' %> is pending approval</strong>
    (submitted by <%= pendingChange.requester ? pendingChange.requester.name : 'someone' %>).
    The content below remains live and unchanged until a checker reviews it.
    <% if (canReview || isOwner) { %>
    — <a href="/change-requests/<%= pendingChange.id %>">view the pending change</a>
    <% } %>
  </div>
</div>
<% } %>

<div class="blog-article">
  <div class="blog-article-header">
    <div class="blog-meta-top">
      <span class="badge badge-<%= blog.status %>"><%= blog.status %></span>
      <% if (blog.tags && blog.tags.length > 0) { %>
        <% blog.tags.forEach(tag => { %><span class="tag">#<%= tag %></span><% }) %>
      <% } %>
    </div>
    <h1 class="blog-article-title"><%= blog.title %></h1>
    <div class="blog-article-meta">
      <div class="author-info">
        <div class="avatar"><%= blog.author ? blog.author.name.charAt(0).toUpperCase() : '?' %></div>
        <div>
          <div class="author-name"><%= blog.author ? blog.author.name : 'Unknown' %></div>
          <div class="publish-date">
            <%= blog.publishedAt
              ? 'Published ' + new Date(blog.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
              : 'Created ' + new Date(blog.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="blog-article-content">
    <%- blog.content.replace(/\n/g, '<br>') %>
  </div>

  <% if (blog.author && blog.author.bio) { %>
  <div class="author-card">
    <div class="avatar"><%= blog.author.name.charAt(0).toUpperCase() %></div>
    <div>
      <strong>About <%= blog.author.name %></strong>
      <p><%= blog.author.bio %></p>
    </div>
  </div>
  <% } %>
</div>
