<div class="page-header">
  <h2>Blog Posts</h2>
  <% if (can('create_blog')) { %>
  <a href="/blogs/create" class="btn btn-primary">
    <i class="fas fa-plus"></i> New Blog
  </a>
  <% } %>
</div>

<div class="search-bar">
  <form action="/blogs" method="GET">
    <div class="input-icon">
      <i class="fas fa-search"></i>
      <input type="text" name="search" class="form-control" placeholder="Search blogs..."
        value="<%= search || '' %>" />
    </div>
    <button type="submit" class="btn btn-outline">Search</button>
    <% if (search) { %><a href="/blogs" class="btn btn-ghost">Clear</a><% } %>
  </form>
</div>

<% if (blogs.length === 0) { %>
<div class="empty-state large">
  <i class="fas fa-newspaper"></i>
  <h3>No blogs found</h3>
  <p><%= search ? 'Try a different search term.' : 'Be the first to write a blog!' %></p>
  <% if (can('create_blog')) { %>
  <a href="/blogs/create" class="btn btn-primary">Write Now</a>
  <% } %>
</div>
<% } else { %>
<div class="blogs-grid">
  <% blogs.forEach(blog => {
    const authorInactive = blog.author && !['approved'].includes(blog.author.status);
  %>
  <div class="blog-card <%= authorInactive ? 'blog-card-disabled' : '' %>">
    <div class="blog-card-header">
      <span class="badge badge-<%= blog.status %>"><%= blog.status %></span>
      <% if (pendingBlogIds && pendingBlogIds.has(blog.id)) { %>
      <span class="badge badge-pending" title="This post has a change awaiting approval">
        <i class="fas fa-hourglass-half" style="font-size:.55rem;margin-right:.2rem"></i>pending review
      </span>
      <% } %>
      <% if (authorInactive) { %>
      <span class="badge badge-suspended" title="Author account is <%= blog.author.status %>">
        <i class="fas fa-ban" style="font-size:.55rem;margin-right:.2rem"></i>author <%= blog.author.status %>
      </span>
      <% } %>
      <% if (!authorInactive && blog.tags && blog.tags.length > 0) { %>
      <div class="tags">
        <% blog.tags.slice(0,2).forEach(tag => { %><span class="tag">#<%= tag %></span><% }) %>
      </div>
      <% } %>
    </div>
    <div class="blog-card-body">
      <h3 class="blog-card-title">
        <% if (authorInactive) { %>
        <span class="disabled-title"><%= blog.title %></span>
        <% } else { %>
        <a href="/blogs/<%= blog.id %>"><%= blog.title %></a>
        <% } %>
      </h3>
      <p class="blog-card-excerpt"><%= blog.excerpt || '' %></p>
    </div>
    <div class="blog-card-footer">
      <div class="blog-author">
        <div class="avatar-sm"><%= blog.author ? blog.author.name.charAt(0).toUpperCase() : '?' %></div>
        <span><%= blog.author ? blog.author.name : 'Unknown' %></span>
      </div>
      <div class="blog-actions">
        <% if (!authorInactive) { %>
        <a href="/blogs/<%= blog.id %>" class="btn btn-sm btn-ghost">Read</a>
        <% } %>
        <% if (can('update_blog') && (blog.authorId === currentUser.id || can('view_all_blogs'))) { %>
        <a href="/blogs/<%= blog.id %>/edit" class="btn btn-sm btn-outline">Edit</a>
        <% } %>
        <% if (can('delete_blog') && (blog.authorId === currentUser.id || can('view_all_blogs'))) { %>
        <form action="/blogs/<%= blog.id %>?_method=DELETE" method="POST" style="display:inline"
          onsubmit="return confirm('Are you sure you want to delete this blog?')">
          <button class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
        </form>
        <% } %>
      </div>
    </div>
  </div>
  <% }) %>
</div>

<% if (totalPages > 1) { %>
<div class="pagination">
  <% if (currentPage > 1) { %>
  <a href="/blogs?page=<%= currentPage - 1 %><%= search ? '&search=' + search : '' %>" class="btn btn-outline btn-sm">
    <i class="fas fa-chevron-left"></i> Prev
  </a>
  <% } %>
  <span class="page-info">Page <%= currentPage %> of <%= totalPages %></span>
  <% if (currentPage < totalPages) { %>
  <a href="/blogs?page=<%= currentPage + 1 %><%= search ? '&search=' + search : '' %>" class="btn btn-outline btn-sm">
    Next <i class="fas fa-chevron-right"></i>
  </a>
  <% } %>
</div>
<% } %>
<% } %>
