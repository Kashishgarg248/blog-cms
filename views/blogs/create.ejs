<div class="page-header">
  <h2>Create New Blog</h2>
  <a href="/blogs" class="btn btn-outline"><i class="fas fa-arrow-left"></i> Back</a>
</div>

<div class="form-page">
  <form action="/blogs" method="POST" id="blogForm" novalidate>
    <div class="form-group">
      <label for="title">Blog Title <span class="required">*</span></label>
      <input type="text" id="title" name="title" class="form-control"
        placeholder="Enter an engaging title..." value="<%= formData.title || '' %>" required />
      <span class="field-error" id="titleError"></span>
    </div>

    <div class="form-group">
      <label for="content">Content <span class="required">*</span></label>
      <textarea id="content" name="content" class="form-control editor"
        placeholder="Write your blog content here..." rows="16" required><%= formData.content || '' %></textarea>
      <span class="field-error" id="contentError"></span>
      <div class="char-count"><span id="charCount">0</span> characters</div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="tags">Tags <span class="optional">(comma-separated)</span></label>
        <input type="text" id="tags" name="tags" class="form-control"
          placeholder="tech, programming, news" value="<%= formData.tags || '' %>" />
      </div>

      <% if (can('publish_blog')) { %>
      <div class="form-group">
        <label for="status">Status</label>
        <select id="status" name="status" class="form-control">
          <option value="draft"     <%= (formData.status === 'draft'     || !formData.status) ? 'selected' : '' %>>Draft</option>
          <option value="published" <%= formData.status === 'published' ? 'selected' : '' %>>Publish Now</option>
        </select>
      </div>
      <% } else { %>
      <input type="hidden" name="status" value="draft" />
      <div class="form-group">
        <label>Status</label>
        <div class="form-control-static">
          <span class="badge badge-draft">Will be saved as Draft</span>
          <small>Contact an admin to publish your blogs.</small>
        </div>
      </div>
      <% } %>
    </div>

    <div class="form-actions">
      <a href="/blogs" class="btn btn-ghost">Cancel</a>
      <button type="submit" class="btn btn-primary" id="blogSubmit">
        <i class="fas fa-save"></i> Create Blog
      </button>
    </div>
  </form>
</div>

<script>
  const content  = document.getElementById('content');
  const charCount = document.getElementById('charCount');
  content.addEventListener('input', () => charCount.textContent = content.value.length);
  charCount.textContent = content.value.length;

  function clearErrors() {
    document.querySelectorAll('.field-error').forEach(el => el.textContent = '');
    document.querySelectorAll('.form-control').forEach(el => el.classList.remove('is-invalid'));
  }

  function setError(fieldId, errorId, msg) {
    document.getElementById(errorId).textContent = msg;
    document.getElementById(fieldId).classList.add('is-invalid');
  }

  function disableBtn(btn) {
    btn.style.opacity = '0.65';
    btn.style.pointerEvents = 'none';
  }

  function resetBtn(btn) {
    btn.style.opacity = '';
    btn.style.pointerEvents = '';
  }

  document.getElementById('blogForm').addEventListener('submit', function (e) {
    clearErrors();
    const title = document.getElementById('title');
    const btn   = document.getElementById('blogSubmit');
    resetBtn(btn); // always reset first

    let valid = true;

    if (!title.value.trim() || title.value.trim().length < 3) {
      setError('title', 'titleError', 'Title must be at least 3 characters.');
      valid = false;
    }
    if (!content.value.trim() || content.value.trim().length < 10) {
      setError('content', 'contentError', 'Content must be at least 10 characters.');
      valid = false;
    }

    if (!valid) {
      e.preventDefault(); // stop submission, button stays enabled
    } else {
      disableBtn(btn);    // only lock when actually submitting
    }
  });
</script>
