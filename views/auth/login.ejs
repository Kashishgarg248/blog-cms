<div class="auth-container">
  <div class="auth-card">
    <div class="auth-logo">
      <h1>BlogCMS</h1>
      <p>Sign in to your account</p>
    </div>

    <form action="/auth/login" method="POST" id="loginForm" novalidate>
      <div class="form-group">
        <label for="email">Email Address</label>
        <div class="input-icon">
          <i class="fas fa-envelope"></i>
          <input type="email" id="email" name="email" class="form-control"
            placeholder="you@example.com" value="<%= formData.email || '' %>" required />
        </div>
        <span class="field-error" id="emailError"></span>
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <div class="input-icon">
          <i class="fas fa-lock"></i>
          <input type="password" id="password" name="password" class="form-control"
            placeholder="Enter your password" required />
          <button type="button" class="toggle-pass" onclick="togglePass('password')">
            <i class="fas fa-eye"></i>
          </button>
        </div>
        <span class="field-error" id="passwordError"></span>
      </div>

      <button type="submit" class="btn btn-primary btn-full" id="loginSubmit">
        <i class="fas fa-sign-in-alt"></i> Login
      </button>
    </form>

    <div class="auth-footer">
      Don't have an account? <a href="/auth/register">Register here</a>
    </div>
  </div>
</div>

<script>
  function togglePass(id) {
    const input = document.getElementById(id);
    input.type = input.type === 'password' ? 'text' : 'password';
  }

  function clearErrors() {
    document.querySelectorAll('.field-error').forEach(el => el.textContent = '');
    document.querySelectorAll('.form-control').forEach(el => el.classList.remove('is-invalid'));
  }

  function setError(fieldId, errorId, msg) {
    document.getElementById(errorId).textContent = msg;
    document.getElementById(fieldId).classList.add('is-invalid');
  }

  function disableBtn(btn) {
    btn.style.opacity = '0.65';
    btn.style.pointerEvents = 'none';
  }

  function resetBtn(btn) {
    btn.style.opacity = '';
    btn.style.pointerEvents = '';
  }

  document.getElementById('loginForm').addEventListener('submit', function(e) {
    clearErrors();
    const email    = document.getElementById('email');
    const password = document.getElementById('password');
    const btn      = document.getElementById('loginSubmit');
    resetBtn(btn); // always reset first so re-attempts work

    let valid = true;
    const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!email.value.trim() || !emailRe.test(email.value)) {
      setError('email', 'emailError', 'Please enter a valid email address.');
      valid = false;
    }
    if (!password.value) {
      setError('password', 'passwordError', 'Password is required.');
      valid = false;
    }

    if (!valid) {
      e.preventDefault(); // stop submission, button stays enabled
    } else {
      disableBtn(btn);    // only lock when actually submitting
    }
  });
</script>
